# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@localhost:5432/autonomous_ops

# --- Redis (optional, for queues/short-lived state) ---
REDIS_URL=redis://localhost:6379/0

# --- GitHub integration (needed for GitHub Actions source + Recovery Agent PRs) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# --- API health monitoring (comma-separated URLs) ---
MONITORED_ENDPOINTS=

# --- Application error logs (path to a file in Python logging's default format) ---
APP_LOG_PATH=

# --- LLM provider — undecided, pick when we build the first reasoning agent ---
LLM_PROVIDER=undecided
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Safety thresholds ---
MAX_RECOVERY_ATTEMPTS=3
CONFIDENCE_THRESHOLD=0.7
REQUIRE_HUMAN_APPROVAL=true
