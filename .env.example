# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+psycopg://<DB_USER>:<DB_PASSWORD>@localhost:5432/autonomous_ops

# --- Redis (optional, for queues/short-lived state) ---
REDIS_URL=redis://localhost:6379/0

# --- GitHub integration (needed for GitHub Actions source + Recovery Agent PRs) ---
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# --- API health monitoring (comma-separated URLs) ---
MONITORED_ENDPOINTS=

# --- Application error logs (path to a file in Python logging's default format) ---
APP_LOG_PATH=

# --- LLM provider (used by Planner and future reasoning agents) ---
# Set to anthropic, openai, or openrouter, and fill in the matching key.
LLM_PROVIDER=openrouter
# LLM_MODEL is required for openrouter (get the exact slug from openrouter.ai/models) —
# anthropic/openai fall back to a sane default if blank.
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Safety thresholds ---
MAX_RECOVERY_ATTEMPTS=3
CONFIDENCE_THRESHOLD=0.7
REQUIRE_HUMAN_APPROVAL=true
